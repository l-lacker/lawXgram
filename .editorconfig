root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.{cmd,bat}]
end_of_line = crlf

# Patches are generated byte-exact; never let an editor touch them.
[*.patch]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false

# Stock Telegram code: keep its formatting so hunks stay minimal.
[worktree/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = false
