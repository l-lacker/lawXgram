From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Neogram Patchset <patches@neogram.invalid>
Subject: debloat/sticker-time: hide the time on stickers

Behind NeoOptions.HIDE_TIME_ON_STICKERS. ChatMessageCell.drawTime skips the time pill of stickers and large emoji messages (MessageObject.isAnyKindOfSticker); it is still drawn while the message is selected.
---
 TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java b/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java
index 0000000..0000000 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java
@@ -21251,6 +21251,9 @@ public class ChatMessageCell extends BaseCell implements SeekBar.SeekBarDelegate
         if (currentMessageObject != null && currentMessageObject.type == MessageObject.TYPE_JOINED_CHANNEL) {
             return;
         }
+        if (ru.llacker.neogram.chat.NeoChat.hideTime(currentMessageObject) && !isDrawSelectionBackground()) {
+            return;
+        }
         for (int i = 0; i < 2; i++) {
             float currentAlpha = alpha;
             if (i == 0 && isDrawSelectionBackground() && currentSelectedBackgroundAlpha == 1f && !shouldDrawTimeOnMedia()) {
